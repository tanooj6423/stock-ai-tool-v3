# Copy to .env and fill in. NEVER commit .env.

# AI explanations (Google Gemini)
GEMINI_API_KEY=

# Zerodha Kite Connect (optional — personal broker link)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Where journal/watchlist/user DB files are stored.
# In Docker this is /data (a mounted volume).
# Locally you can leave it unset (defaults to ./data).
# DATA_DIR=/data

# ---------------- Accounts & monetization ----------------
# Your email — this account is always Pro and sees the admin panel.
ADMIN_EMAIL=

# Set to 1 to bypass login entirely (local development only).
# AUTH_DISABLED=1

# Public URL of the app (used as Razorpay payment redirect).
# APP_URL=https://yourdomain.com

# Razorpay — either API keys (auto-upgrade via webhook)...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# ...or zero-code Payment Page links from the Razorpay dashboard:
RAZORPAY_LINK_MONTHLY=
RAZORPAY_LINK_YEARLY=
