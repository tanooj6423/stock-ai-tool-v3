# Copy to .env and fill in. NEVER commit .env.

# AI explanations (Google Gemini)
GEMINI_API_KEY=

# Zerodha Kite Connect (optional — personal broker link)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Alpaca (optional — US stocks tab)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Where journal/watchlist JSON files are stored.
# In Docker this is /data (a mounted volume).
# Locally you can leave it unset (defaults to ./data).
# DATA_DIR=/data
